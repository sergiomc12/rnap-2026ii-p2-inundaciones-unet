\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \emph  {Arriba}: densidades de VV condicionadas a la verdad. El área negra es el solape, 41.2\% de la masa. La banda gris es la zona donde ninguna clase domina el bin. \emph  {Abajo}: dónde caen los errores del modelo. El 75.5\% de los falsos positivos y el 94\% de los negativos están dentro de esa zona.}}{8}{figure.caption.20}\protected@file@percent }
\newlabel{fig:separabilidad}{{2}{8}{\emph {Arriba}: densidades de VV condicionadas a la verdad. El área negra es el solape, 41.2\% de la masa. La banda gris es la zona donde ninguna clase domina el bin. \emph {Abajo}: dónde caen los errores del modelo. El 75.5\% de los falsos positivos y el 94\% de los negativos están dentro de esa zona}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Un ejemplo de cada modo de fallo del sensor; en cada fila: VV en dB, la verdad, los errores (acierto de agua verde, falsos positivos rojo, falsos negativos azul) y el histograma de VV con la zona ambigua sombreada. \emph  {Modo 1}, solape (\texttt  {India\_399883}): el error cae en la zona gris. \emph  {Modo 2}, especular (\texttt  {Pakistan\_70625}): campos secos marcados como agua. \emph  {Modo 3}, agua brillante como suelo (\texttt  {Pakistan\_849790}): el agua turbulenta se pierde como falso negativo.}}{8}{figure.caption.22}\protected@file@percent }
\newlabel{fig:fallo}{{3}{8}{Un ejemplo de cada modo de fallo del sensor; en cada fila: VV en dB, la verdad, los errores (acierto de agua verde, falsos positivos rojo, falsos negativos azul) y el histograma de VV con la zona ambigua sombreada. \emph {Modo 1}, solape (\texttt {India\_399883}): el error cae en la zona gris. \emph {Modo 2}, especular (\texttt {Pakistan\_70625}): campos secos marcados como agua. \emph {Modo 3}, agua brillante como suelo (\texttt {Pakistan\_849790}): el agua turbulenta se pierde como falso negativo}{figure.caption.22}{}}
